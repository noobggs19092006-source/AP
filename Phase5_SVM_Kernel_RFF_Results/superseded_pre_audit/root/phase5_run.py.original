#!/usr/bin/env python3
"""
phase5_run.py — Master Execution Pipeline for Phase 5
Project: Spatiotemporal Air Pollution State Prediction Using HoSVD and Kernel SVM

Executes the modular pipeline sequentially:
  Stage 1: s01_integrity_gate.py
  Stage 2: s02_qp_verification.py
  Stage 3: s03_stage_a_linear_svm.py (40 LinearSVC fits)
  Stage 4: s04_stage_b_rbf_svc.py (Bounded Exact RBF SVC, 4k/8k subsets)
  Stage 5: s05_stage_c_rff.py (Random Fourier Features)
  Stage 6: s06_selection_and_evaluation.py (Lock, Calibration & Test Evaluation)
  Stage 7: s07_comparative_studies.py (Comparative Studies, Pareto & Bootstrap)
  Stage 8: pytest test suite (14 automated checks)
"""

import argparse
import subprocess
import sys
import time
from pathlib import Path


def parse_args():
    parser = argparse.ArgumentParser(description="Phase 5 Master Pipeline Runner")
    parser.add_argument("--input-dir", type=str, default=".", help="Path to input files directory")
    parser.add_argument("--output-dir", type=str, default="output", help="Path to output directory")
    parser.add_argument("--seed", type=int, default=42, help="Random seed")
    parser.add_argument(
        "--stage",
        type=str,
        default="all",
        choices=["all", "gate", "qp", "stage_a", "stage_b", "stage_c", "eval", "comparative", "test"],
        help="Pipeline stage to execute"
    )
    return parser.parse_args()


def run_cmd(cmd, desc):
    print("\n" + "=" * 70)
    print(f"RUNNING: {desc}")
    print(f"COMMAND: {' '.join(cmd)}")
    print("=" * 70)
    start_t = time.time()
    res = subprocess.run(cmd)
    elapsed = time.time() - start_t
    if res.returncode != 0:
        print(f"\n[ERROR] {desc} failed with exit code {res.returncode} in {elapsed:.2f}s!")
        sys.exit(res.returncode)
    print(f"\n[SUCCESS] {desc} completed successfully in {elapsed:.2f}s.")


def main():
    args = parse_args()
    py = sys.executable
    in_dir = str(Path(args.input_dir).resolve())
    out_dir = str(Path(args.output_dir).resolve())
    seed = str(args.seed)

    src_dir = Path(out_dir) / "source"

    stages = {
        "gate": ([py, str(src_dir / "s01_integrity_gate.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Hard Data-Integrity Gate"),
        "qp": ([py, str(src_dir / "s02_qp_verification.py"), "--output-dir", out_dir, "--seed", seed], "Small QP Verification"),
        "stage_a": ([py, str(src_dir / "s03_stage_a_linear_svm.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Stage A: 40 LinearSVC Fits"),
        "stage_b": ([py, str(src_dir / "s04_stage_b_rbf_svc.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Stage B: Exact RBF Kernel SVC"),
        "stage_c": ([py, str(src_dir / "s05_stage_c_rff.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Stage C: Random Fourier Features"),
        "eval": ([py, str(src_dir / "s06_selection_and_evaluation.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Model Selection, Calibration & Evaluation"),
        "comparative": ([py, str(src_dir / "s07_comparative_studies.py"), "--input-dir", in_dir, "--output-dir", out_dir, "--seed", seed], "Comparative Studies, Pareto & Bootstrap"),
        "test": ([py, "-m", "pytest", str(Path(out_dir) / "tests" / "test_phase5_full.py"), "-v", "--tb=short"], "Automated Test Suite (14 Tests)")
    }

    if args.stage == "all":
        order = ["gate", "qp", "stage_a", "stage_c", "eval", "comparative", "test"]
        print("Executing full Phase 5 pipeline (excluding unbounded Stage B)...")
        for stg in order:
            cmd, desc = stages[stg]
            run_cmd(cmd, desc)
    else:
        cmd, desc = stages[args.stage]
        run_cmd(cmd, desc)

    print("\n" + "=" * 70)
    print("ALL REQUESTED PHASE 5 STAGES COMPLETED SUCCESSFULLY!")
    print("=" * 70)


if __name__ == "__main__":
    main()
