#!/usr/bin/env python3
"""
s04_stage_b_rbf_svc.py — Stage B: Exact RBF Kernel SVC
Phase 5 SVM/RFF Air Pollution Classification

Sections:
  STEP 1  Load scaled features (pca_B, hosvd_B, d=192)
  STEP 2  RBF grid: gamma_scales=[0.1,1,10], C=[0.1,1,10], fit_n=[4000,8000]
  STEP 3  Resource monitoring (RAM guard, skip logic)
  STEP 4  OvR vs OvO ablation on best (gamma,C) at fit_n=4000
  STEP 5  Save results, figures, predictions, checkpoints
"""

import os
import sys
import time
import pickle
import logging
import traceback
from pathlib import Path
from datetime import datetime

import numpy as np
import pandas as pd
import psutil
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker

from sklearn.svm import SVC
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    accuracy_score, f1_score, balanced_accuracy_score,
    classification_report, confusion_matrix
)

import argparse

parser = argparse.ArgumentParser(description="Stage B: Exact RBF Kernel SVC")
parser.add_argument("--input-dir", type=str, default="/Users/abhaychirayil/Desktop/Phase 5 Input FIles", help="Input directory")
parser.add_argument("--output-dir", type=str, default="/Users/abhaychirayil/Desktop/Phase 5 Input FIles/output", help="Output directory")
parser.add_argument("--seed", type=int, default=42, help="Random seed")
cli_args, _ = parser.parse_known_args()

# ─── Paths ────────────────────────────────────────────────────────────────────
INPUT_DIR  = Path(cli_args.input_dir)
OUTPUT_DIR = Path(cli_args.output_dir)

LOG_DIR         = OUTPUT_DIR / "logs"
RESULTS_DIR     = OUTPUT_DIR / "results"
FIGURES_DIR     = OUTPUT_DIR / "figures"
CHECKPOINTS_DIR = OUTPUT_DIR / "checkpoints"
PREDICTIONS_DIR = OUTPUT_DIR / "predictions"
MODELS_DIR      = OUTPUT_DIR / "models"

for d in [LOG_DIR, RESULTS_DIR, FIGURES_DIR, CHECKPOINTS_DIR, PREDICTIONS_DIR, MODELS_DIR]:
    d.mkdir(parents=True, exist_ok=True)

# ─── Logging ──────────────────────────────────────────────────────────────────
log_file = LOG_DIR / "s04_stage_b.log"
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[
        logging.FileHandler(log_file, mode="w"),
        logging.StreamHandler(sys.stdout),
    ],
)
log = logging.getLogger(__name__)
log.info("=" * 70)
log.info("Stage B: Exact RBF Kernel SVC — started at %s", datetime.now().isoformat())
log.info("=" * 70)

# ─── Grid parameters ──────────────────────────────────────────────────────────
D             = 192          # feature dimension for pca_B / hosvd_B
GAMMA_SCALES  = [0.1, 1, 10]  # gamma = scale / D
C_VALUES      = [0.1, 1, 10]
FIT_NS        = [4000, 8000]
CONFIGS       = ["pca_B", "hosvd_B"]
RANDOM_STATE  = 42
CACHE_SIZE_MB = 2000

CLASS_NAMES   = {0: "Low", 1: "Moderate", 2: "High"}


# ─── Utility helpers ──────────────────────────────────────────────────────────

def rss_mb():
    """Current RSS of this process in MB."""
    return psutil.Process(os.getpid()).memory_info().rss / 1024**2


def available_ram_gb():
    """Available system RAM in GB."""
    return psutil.virtual_memory().available / 1024**3


def estimate_svm_peak_mb(n_train: int, n_features: int, cache_mb: int = CACHE_SIZE_MB) -> float:
    """
    Conservative peak RAM estimate for libsvm:
      - Feature matrix (float64): n*d*8 bytes
      - Kernel cache: cache_mb MB
      - Support vector storage: assume up to 50% SVs × 8 bytes × d
      Total in MB.
    """
    feat_mb    = n_train * n_features * 8 / 1024**2
    sv_mb      = 0.5 * n_train * n_features * 8 / 1024**2
    return feat_mb + sv_mb + cache_mb


def load_npz(split: str, config: str):
    """Return F (float32→float64), y, current_state, target_timestamp arrays."""
    path = INPUT_DIR / f"features_{split}_{config}.npz"
    d = np.load(path, allow_pickle=False)
    F  = d["F"].astype(np.float64)
    y  = d["y"].astype(np.int32)
    cs = d["current_state"]
    ts = d["target_timestamp"]
    return F, y, cs, ts


def apply_frozen_scaler(F: np.ndarray, config: str) -> np.ndarray:
    """
    Apply the frozen StandardScaler saved by Stage A.
    If not found, fit a new one on the TRAIN split (should not happen in normal flow).
    """
    scaler_path = MODELS_DIR / f"scaler_{config}.npz"
    if scaler_path.exists():
        sc_data = np.load(scaler_path)
        mean_   = sc_data["mean_"]
        scale_  = sc_data["scale_"]
        log.info("  Loaded frozen scaler for %s from %s", config, scaler_path)
        F_scaled = (F - mean_) / scale_
    else:
        log.warning(
            "  Scaler NOT found at %s — fitting new scaler on this split's data "
            "(fallback, may differ from Stage A)", scaler_path
        )
        sc = StandardScaler()
        F_scaled = sc.fit_transform(F)
        # Save for reproducibility
        np.savez(scaler_path, mean_=sc.mean_, scale_=sc.scale_)
    return F_scaled


def eval_metrics(y_true, y_pred, scope_mask=None):
    """Return dict of classification metrics, optionally scoped."""
    if scope_mask is not None:
        y_true = y_true[scope_mask]
        y_pred = y_pred[scope_mask]
    if len(y_true) == 0:
        return {}
    present_classes = sorted(np.unique(y_true))
    report = classification_report(
        y_true, y_pred,
        labels=present_classes,
        target_names=[CLASS_NAMES[c] for c in present_classes],
        output_dict=True,
        zero_division=0,
    )
    return {
        "n_samples"        : int(len(y_true)),
        "accuracy"         : float(accuracy_score(y_true, y_pred)),
        "macro_f1"         : float(f1_score(y_true, y_pred, average="macro",    zero_division=0)),
        "weighted_f1"      : float(f1_score(y_true, y_pred, average="weighted", zero_division=0)),
        "balanced_accuracy": float(balanced_accuracy_score(y_true, y_pred)),
        "per_class"        : report,
    }


# ─── STEP 1: Load data ────────────────────────────────────────────────────────
log.info("\n%s\nSTEP 1: Loading and scaling features\n%s", "="*70, "="*70)

data = {}  # config → {"F_train","y_train","cs_train","ts_train","F_val","y_val","cs_val","ts_val"}

for config in CONFIGS:
    log.info("Loading %s …", config)
    F_tr, y_tr, cs_tr, ts_tr = load_npz("train",      config)
    F_va, y_va, cs_va, ts_va = load_npz("validation", config)

    log.info("  train raw: F=%s y=%s", F_tr.shape, y_tr.shape)
    log.info("  val   raw: F=%s y=%s", F_va.shape, y_va.shape)

    # Scale using frozen scaler
    F_tr_sc = apply_frozen_scaler(F_tr, config)
    # Apply same transform (not fit) to validation
    scaler_path = MODELS_DIR / f"scaler_{config}.npz"
    if scaler_path.exists():
        sc_data = np.load(scaler_path)
        mean_   = sc_data["mean_"]
        scale_  = sc_data["scale_"]
        F_va_sc = (F_va - mean_) / scale_
    else:
        # Fallback: re-fit on train, transform val
        sc = StandardScaler().fit(F_tr)
        F_va_sc = sc.transform(F_va)

    log.info("  train scaled: mean=%.4f std=%.4f", F_tr_sc.mean(), F_tr_sc.std())
    log.info("  val   scaled: mean=%.4f std=%.4f", F_va_sc.mean(), F_va_sc.std())

    # Class distribution
    unique, counts = np.unique(y_tr, return_counts=True)
    dist_str = ", ".join(f"{CLASS_NAMES[c]}={n}" for c, n in zip(unique, counts))
    log.info("  train class dist: %s", dist_str)

    data[config] = {
        "F_train" : F_tr_sc,
        "y_train" : y_tr,
        "cs_train": cs_tr,
        "ts_train": ts_tr,
        "F_val"   : F_va_sc,
        "y_val"   : y_va,
        "cs_val"  : cs_va,
        "ts_val"  : ts_va,
    }


# ─── STEP 2 & 3: RBF grid with resource monitoring ────────────────────────────
log.info("\n%s\nSTEP 2+3: RBF Grid Search with resource monitoring\n%s", "="*70, "="*70)
log.info("Grid: gamma_scales=%s, C=%s, fit_n=%s", GAMMA_SCALES, C_VALUES, FIT_NS)
log.info("Note: 24108² float64 Gram ≈ 4.33 GiB if materialized; "
         "libsvm uses kernel caching (cache_size=%d MB) so full matrix is NOT stored.",
         CACHE_SIZE_MB)

all_rows = []   # accumulate result dicts
skipped  = []   # track skipped experiments

TOTAL_PLANNED = len(CONFIGS) * len(FIT_NS) * len(GAMMA_SCALES) * len(C_VALUES)  # 2*2*3*3 = 36
fits_done   = 0
fits_tried  = 0

for fit_n in FIT_NS:
    for config in CONFIGS:
        for gamma_scale in GAMMA_SCALES:
            for C in C_VALUES:
                gamma   = gamma_scale / D
                tag     = f"{config}_fn{fit_n}_g{gamma_scale}_C{C}"
                ckpt_fp = CHECKPOINTS_DIR / f"stage_b_{tag}.pkl"
                pred_fp = PREDICTIONS_DIR / f"stage_b_{tag}_val.csv"

                log.info("\n--- %s  gamma=%.6f  C=%.2f  fit_n=%d ---", config, gamma, C, fit_n)

                # ── Subset selection ─────────────────────────────────────────
                F_full = data[config]["F_train"]
                y_full = data[config]["y_train"]
                cs_tr  = data[config]["cs_train"]
                ts_tr  = data[config]["ts_train"]

                # Chronological first fit_n rows
                X_sub = F_full[:fit_n]
                y_sub = y_full[:fit_n]

                unique_s, cnt_s = np.unique(y_sub, return_counts=True)
                dist_sub = ", ".join(f"{CLASS_NAMES[c]}={n}" for c, n in zip(unique_s, cnt_s))
                log.info("  Subset class dist: %s", dist_sub)

                # Time range of subset
                try:
                    ts_sub = ts_tr[:fit_n]
                    log.info("  Subset time range: %s → %s", ts_sub[0], ts_sub[-1])
                except Exception:
                    log.info("  (timestamp info unavailable)")

                # ── RAM guard ─────────────────────────────────────────────────
                avail_ram_gb = available_ram_gb()
                est_peak_mb  = estimate_svm_peak_mb(fit_n, D)
                log.info("  Available RAM: %.2f GB | Estimated peak: %.0f MB",
                         avail_ram_gb, est_peak_mb)

                if est_peak_mb > 0.9 * avail_ram_gb * 1024:
                    reason = (f"RAM guard triggered: est_peak={est_peak_mb:.0f} MB > "
                              f"90% avail={0.9*avail_ram_gb*1024:.0f} MB")
                    log.warning("  SKIP: %s", reason)
                    skipped.append({"tag": tag, "reason": reason})
                    all_rows.append({
                        "config": config, "fit_n": fit_n, "gamma_scale": gamma_scale,
                        "gamma": gamma, "C": C, "status": "skipped", "skip_reason": reason,
                    })
                    continue

                # ── Fit SVC ───────────────────────────────────────────────────
                fits_tried += 1
                rss_before = rss_mb()
                t0 = time.perf_counter()

                try:
                    clf = SVC(
                        kernel="rbf",
                        gamma=gamma,
                        C=C,
                        random_state=RANDOM_STATE,
                        decision_function_shape="ovr",
                        cache_size=CACHE_SIZE_MB,
                    )
                    clf.fit(X_sub, y_sub)
                    fit_time = time.perf_counter() - t0
                except MemoryError as me:
                    reason = f"MemoryError during fit: {me}"
                    log.error("  FAIL: %s", reason)
                    skipped.append({"tag": tag, "reason": reason})
                    all_rows.append({
                        "config": config, "fit_n": fit_n, "gamma_scale": gamma_scale,
                        "gamma": gamma, "C": C, "status": "oom", "skip_reason": reason,
                    })
                    continue
                except Exception as exc:
                    reason = f"Exception during fit: {exc}"
                    log.error("  FAIL: %s\n%s", reason, traceback.format_exc())
                    skipped.append({"tag": tag, "reason": reason})
                    all_rows.append({
                        "config": config, "fit_n": fit_n, "gamma_scale": gamma_scale,
                        "gamma": gamma, "C": C, "status": "error", "skip_reason": reason,
                    })
                    continue

                rss_after = rss_mb()
                n_sv       = int(clf.n_support_.sum())
                model_bytes= sys.getsizeof(pickle.dumps(clf))
                peak_mem   = rss_after - rss_before

                log.info("  fit_time=%.2fs  n_SVs=%d  model_size=%.1f KB  peak_mem_delta=%.1f MB",
                         fit_time, n_sv, model_bytes/1024, peak_mem)

                # ── Validation evaluation (Scope A and Scope B) ───────────────
                F_val  = data[config]["F_val"]
                y_val  = data[config]["y_val"]
                cs_val = data[config]["cs_val"]

                y_pred = clf.predict(F_val)

                # Scope A: current_state >= 0
                scope_a_mask = (cs_val >= 0)
                # Scope B: all samples
                scope_b_mask = np.ones(len(y_val), dtype=bool)

                metrics_a = eval_metrics(y_val, y_pred, scope_a_mask)
                metrics_b = eval_metrics(y_val, y_pred, scope_b_mask)

                log.info("  Val Scope A (n=%d): acc=%.4f macro_f1=%.4f bal_acc=%.4f",
                         metrics_a.get("n_samples", 0),
                         metrics_a.get("accuracy", 0),
                         metrics_a.get("macro_f1", 0),
                         metrics_a.get("balanced_accuracy", 0))
                log.info("  Val Scope B (n=%d): acc=%.4f macro_f1=%.4f bal_acc=%.4f",
                         metrics_b.get("n_samples", 0),
                         metrics_b.get("accuracy", 0),
                         metrics_b.get("macro_f1", 0),
                         metrics_b.get("balanced_accuracy", 0))

                # ── Save predictions ──────────────────────────────────────────
                pred_df = pd.DataFrame({
                    "y_true"  : y_val,
                    "y_pred"  : y_pred,
                    "scope_a" : scope_a_mask.astype(int),
                })
                pred_df.to_csv(pred_fp, index=False)

                # ── Save checkpoint ───────────────────────────────────────────
                with open(ckpt_fp, "wb") as f:
                    pickle.dump({"clf": clf, "config": config, "fit_n": fit_n,
                                 "gamma": gamma, "C": C, "metrics_a": metrics_a,
                                 "metrics_b": metrics_b}, f)

                fits_done += 1

                # ── Accumulate result row ─────────────────────────────────────
                row = {
                    "config"           : config,
                    "fit_n"            : fit_n,
                    "gamma_scale"      : gamma_scale,
                    "gamma"            : gamma,
                    "C"                : C,
                    "status"           : "done",
                    "fit_time_s"       : round(fit_time, 4),
                    "n_support_vectors": n_sv,
                    "model_size_bytes" : model_bytes,
                    "peak_memory_mb"   : round(peak_mem, 2),
                    # Scope A
                    "scopeA_n"         : metrics_a.get("n_samples", 0),
                    "scopeA_accuracy"  : round(metrics_a.get("accuracy", 0), 6),
                    "scopeA_macro_f1"  : round(metrics_a.get("macro_f1", 0), 6),
                    "scopeA_weighted_f1": round(metrics_a.get("weighted_f1", 0), 6),
                    "scopeA_bal_acc"   : round(metrics_a.get("balanced_accuracy", 0), 6),
                    # Scope B
                    "scopeB_n"         : metrics_b.get("n_samples", 0),
                    "scopeB_accuracy"  : round(metrics_b.get("accuracy", 0), 6),
                    "scopeB_macro_f1"  : round(metrics_b.get("macro_f1", 0), 6),
                    "scopeB_weighted_f1": round(metrics_b.get("weighted_f1", 0), 6),
                    "scopeB_bal_acc"   : round(metrics_b.get("balanced_accuracy", 0), 6),
                }
                # Per-class metrics — Scope B
                for cls_name in ["Low", "Moderate", "High"]:
                    cls_data = metrics_b.get("per_class", {}).get(cls_name, {})
                    row[f"scopeB_{cls_name}_precision"] = round(cls_data.get("precision", 0), 6)
                    row[f"scopeB_{cls_name}_recall"]    = round(cls_data.get("recall", 0), 6)
                    row[f"scopeB_{cls_name}_f1"]        = round(cls_data.get("f1-score", 0), 6)

                all_rows.append(row)

log.info("\nGrid complete: %d/%d fits done, %d skipped/failed",
         fits_done, TOTAL_PLANNED, len(skipped))


# ─── STEP 4: OvR vs OvO ablation ─────────────────────────────────────────────
log.info("\n%s\nSTEP 4: OvR vs OvO Ablation\n%s", "="*70, "="*70)
log.info(
    "Note: sklearn SVC always trains ONE-VS-ONE (OvO) classifiers internally.\n"
    "  decision_function_shape='ovo'  → raw OvO decision scores, Platt-scale voting\n"
    "  decision_function_shape='ovr'  → transforms OvO scores to OvR-shaped output via\n"
    "    _ovr_decision_function(), which rescales to [-1,+1] per class and sums.\n"
    "  PREDICTIONS may differ because the aggregation of OvO votes differs.\n"
    "  This ablation measures the PREDICTION impact of that reshaping, not of re-training."
)

ablation_rows = []

for config in CONFIGS:
    # Find best (gamma_scale, C) by Scope B macro_f1 at fit_n=4000 among done rows
    done_rows_config = [
        r for r in all_rows
        if r["config"] == config and r["fit_n"] == 4000 and r.get("status") == "done"
    ]
    if not done_rows_config:
        log.warning("  No completed fits for %s at fit_n=4000; skipping ablation.", config)
        continue

    best_row = max(done_rows_config, key=lambda r: r["scopeB_macro_f1"])
    best_gs  = best_row["gamma_scale"]
    best_C   = best_row["C"]
    best_gamma = best_gs / D

    log.info("  %s best: gamma_scale=%s C=%s → scopeB_macro_f1=%.6f",
             config, best_gs, best_C, best_row["scopeB_macro_f1"])

    # Data
    F_full = data[config]["F_train"]
    y_full = data[config]["y_train"]
    X_sub  = F_full[:4000]
    y_sub  = y_full[:4000]
    F_val  = data[config]["F_val"]
    y_val  = data[config]["y_val"]
    cs_val = data[config]["cs_val"]
    scope_b_mask = np.ones(len(y_val), dtype=bool)

    for dfs in ["ovr", "ovo"]:
        log.info("  Fitting %s dfs=%s …", config, dfs)
        rss0 = rss_mb()
        t0   = time.perf_counter()
        try:
            clf = SVC(
                kernel="rbf",
                gamma=best_gamma,
                C=best_C,
                random_state=RANDOM_STATE,
                decision_function_shape=dfs,
                cache_size=CACHE_SIZE_MB,
            )
            clf.fit(X_sub, y_sub)
            ft  = time.perf_counter() - t0
            rss1 = rss_mb()
            y_pred = clf.predict(F_val)
            m = eval_metrics(y_val, y_pred, scope_b_mask)
            ablation_rows.append({
                "config"              : config,
                "fit_n"              : 4000,
                "gamma_scale"         : best_gs,
                "gamma"               : best_gamma,
                "C"                   : best_C,
                "decision_function_shape": dfs,
                "macro_f1"            : round(m.get("macro_f1", 0), 6),
                "accuracy"            : round(m.get("accuracy", 0), 6),
                "balanced_accuracy"   : round(m.get("balanced_accuracy", 0), 6),
                "weighted_f1"         : round(m.get("weighted_f1", 0), 6),
                "fit_time_s"          : round(ft, 4),
                "n_support_vectors"   : int(clf.n_support_.sum()),
                "peak_memory_mb"      : round(rss1 - rss0, 2),
            })
            log.info("    dfs=%s: macro_f1=%.6f acc=%.6f fit_time=%.2fs n_sv=%d",
                     dfs, m.get("macro_f1", 0), m.get("accuracy", 0),
                     ft, int(clf.n_support_.sum()))
        except Exception as exc:
            log.error("  Ablation FAIL %s dfs=%s: %s", config, dfs, exc)

# OvR vs OvO delta
for config in CONFIGS:
    ovr_row = next((r for r in ablation_rows if r["config"]==config and r["decision_function_shape"]=="ovr"), None)
    ovo_row = next((r for r in ablation_rows if r["config"]==config and r["decision_function_shape"]=="ovo"), None)
    if ovr_row and ovo_row:
        delta = ovr_row["macro_f1"] - ovo_row["macro_f1"]
        log.info("  %s OvR–OvO macro_f1 diff = %.6f (OvR=%.6f OvO=%.6f)",
                 config, delta, ovr_row["macro_f1"], ovo_row["macro_f1"])


# ─── STEP 5: Save results & figures ───────────────────────────────────────────
log.info("\n%s\nSTEP 5: Saving results & figures\n%s", "="*70, "="*70)

# --- stage_b_all_candidates.csv ---
df_all = pd.DataFrame(all_rows)
csv_all = RESULTS_DIR / "stage_b_all_candidates.csv"
df_all.to_csv(csv_all, index=False)
log.info("Saved %s (%d rows)", csv_all, len(df_all))

# --- stage_b_ovr_ovo_ablation.csv ---
df_abl = pd.DataFrame(ablation_rows)
csv_abl = RESULTS_DIR / "stage_b_ovr_ovo_ablation.csv"
df_abl.to_csv(csv_abl, index=False)
log.info("Saved %s (%d rows)", csv_abl, len(df_abl))

# --- Heatmaps ---
def plot_heatmap(config: str, fit_n: int, df: pd.DataFrame, out_path: Path):
    """Plot gamma×C heatmap of val Scope B macro-F1."""
    done = df[(df["config"] == config) & (df["fit_n"] == fit_n) & (df.get("status", "done") == "done")].copy()
    if done.empty:
        log.warning("  No data for heatmap %s fn%d", config, fit_n)
        return

    gamma_labels = [str(g) for g in GAMMA_SCALES]
    C_labels     = [str(c) for c in C_VALUES]
    mat = np.full((len(GAMMA_SCALES), len(C_VALUES)), np.nan)

    for _, row in done.iterrows():
        gi = GAMMA_SCALES.index(row["gamma_scale"])
        ci = C_VALUES.index(row["C"])
        mat[gi, ci] = row["scopeB_macro_f1"]

    fig, ax = plt.subplots(figsize=(5, 4))
    im = ax.imshow(mat, vmin=0, vmax=1, cmap="YlGnBu", aspect="auto")
    ax.set_xticks(range(len(C_labels)));     ax.set_xticklabels([f"C={c}" for c in C_labels])
    ax.set_yticks(range(len(gamma_labels))); ax.set_yticklabels([f"γ_scale={g}" for g in gamma_labels])
    for gi in range(len(GAMMA_SCALES)):
        for ci in range(len(C_VALUES)):
            val = mat[gi, ci]
            txt = f"{val:.4f}" if not np.isnan(val) else "N/A"
            ax.text(ci, gi, txt, ha="center", va="center", fontsize=9,
                    color="black" if val > 0.5 else "white")
    plt.colorbar(im, ax=ax, label="Scope B macro-F1")
    ax.set_title(f"{config} RBF Grid | fit_n={fit_n}")
    plt.tight_layout()
    plt.savefig(out_path, dpi=120)
    plt.close()
    log.info("  Saved heatmap: %s", out_path)


for config in CONFIGS:
    for fit_n in FIT_NS:
        safe_config = config.replace("_", "")  # pca_B→pcaB for filename
        fig_path = FIGURES_DIR / f"stage_b_rbf_heatmap_{config}_fn{fit_n}.png"
        # Canonical named outputs
        if config == "pca_B" and fit_n == FIT_NS[0]:
            canonical = FIGURES_DIR / "stage_b_rbf_heatmap_pca_b.png"
        elif config == "hosvd_B" and fit_n == FIT_NS[0]:
            canonical = FIGURES_DIR / "stage_b_rbf_heatmap_hosvd_b.png"
        else:
            canonical = None

        # Reindex gamma_scale for numeric lookup
        df_plot = df_all.copy()
        if "gamma_scale" not in df_plot.columns:
            df_plot["gamma_scale"] = (df_plot["gamma"] * D).round(1)
        df_plot["status"] = df_plot.get("status", pd.Series(["done"]*len(df_plot)))

        plot_heatmap(config, fit_n, df_plot, fig_path)
        if canonical and fig_path != canonical:
            import shutil
            shutil.copy(fig_path, canonical)
            log.info("  Also saved canonical: %s", canonical)

# Combined heatmap figure (2 rows × 2 fit_n, side-by-side)
try:
    fig, axes = plt.subplots(2, 2, figsize=(10, 8))
    fig.suptitle("RBF SVC — Val Scope B macro-F1 Heatmaps", fontsize=13)

    for row_i, config in enumerate(CONFIGS):
        for col_i, fit_n in enumerate(FIT_NS):
            ax = axes[row_i][col_i]
            done = df_all[
                (df_all["config"] == config) &
                (df_all["fit_n"] == fit_n) &
                (df_all.get("status", pd.Series(["done"]*len(df_all))) == "done")
            ]
            mat = np.full((len(GAMMA_SCALES), len(C_VALUES)), np.nan)
            for _, row in done.iterrows():
                gi = GAMMA_SCALES.index(row["gamma_scale"])
                ci = C_VALUES.index(row["C"])
                mat[gi, ci] = row["scopeB_macro_f1"]
            im = ax.imshow(mat, vmin=0, vmax=1, cmap="YlGnBu", aspect="auto")
            ax.set_xticks(range(len(C_VALUES)));     ax.set_xticklabels([f"C={c}" for c in C_VALUES])
            ax.set_yticks(range(len(GAMMA_SCALES))); ax.set_yticklabels([f"γ={g}" for g in GAMMA_SCALES])
            ax.set_title(f"{config} fn={fit_n}")
            for gi in range(len(GAMMA_SCALES)):
                for ci in range(len(C_VALUES)):
                    v = mat[gi, ci]
                    ax.text(ci, gi, f"{v:.3f}" if not np.isnan(v) else "N/A",
                            ha="center", va="center", fontsize=8)
    plt.tight_layout()
    plt.savefig(FIGURES_DIR / "stage_b_rbf_heatmap_all.png", dpi=120)
    plt.close()
    log.info("  Saved combined heatmap: %s", FIGURES_DIR / "stage_b_rbf_heatmap_all.png")
except Exception as e:
    log.warning("  Combined heatmap failed: %s", e)


# ─── Summary ──────────────────────────────────────────────────────────────────
log.info("\n%s\nFINAL SUMMARY\n%s", "="*70, "="*70)
log.info("Total planned: %d | Done: %d | Skipped/Failed: %d",
         TOTAL_PLANNED, fits_done, len(skipped))

done_df = df_all[df_all.get("status", pd.Series(["done"]*len(df_all))) == "done"] if len(df_all) > 0 else pd.DataFrame()

best_summary = {}
for config in CONFIGS:
    sub = done_df[done_df["config"] == config] if len(done_df) > 0 else pd.DataFrame()
    if len(sub) == 0:
        log.info("  %s: no completed fits", config)
        best_summary[config] = None
        continue
    best = sub.loc[sub["scopeB_macro_f1"].idxmax()]
    best_summary[config] = best
    log.info("  %s best: gamma_scale=%s C=%s fit_n=%s → scopeB_macro_f1=%.6f",
             config, best["gamma_scale"], best["C"], best["fit_n"], best["scopeB_macro_f1"])

for sk in skipped:
    log.info("  SKIPPED: %s — %s", sk["tag"], sk["reason"])

# OvR vs OvO delta for board post
delta_str = {}
for config in CONFIGS:
    ovr_row = next((r for r in ablation_rows if r["config"]==config and r["decision_function_shape"]=="ovr"), None)
    ovo_row = next((r for r in ablation_rows if r["config"]==config and r["decision_function_shape"]=="ovo"), None)
    if ovr_row and ovo_row:
        delta_str[config] = round(ovr_row["macro_f1"] - ovo_row["macro_f1"], 6)
    else:
        delta_str[config] = "N/A"

log.info("\nOvR vs OvO macro_f1 deltas: %s", delta_str)
log.info("\nStage B complete.")

# Print machine-readable summary for board
print("\n" + "="*70)
print("STAGE_B_SUMMARY")
print(f"fits_done={fits_done} of {TOTAL_PLANNED}")
print(f"skipped={len(skipped)}")
for config in CONFIGS:
    b = best_summary.get(config)
    if b is not None:
        print(f"best_{config}: gamma_scale={b['gamma_scale']} C={b['C']} fn={b['fit_n']} macro_f1={b['scopeB_macro_f1']:.6f}")
    else:
        print(f"best_{config}: N/A")
for config in CONFIGS:
    print(f"ovr_ovo_delta_{config}={delta_str.get(config, 'N/A')}")
print("="*70)
